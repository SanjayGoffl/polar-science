# Copy to .env and fill in what you need. Every value has a working default:
# with no API keys at all, the app uses its offline summariser (extractive, still cited).
# Never commit .env; it is gitignored.

# --- AI ---------------------------------------------------------------------
# Provider order: openrouter (default) | gemini | mock (offline only).
# Providers without a key are skipped automatically; the offline summariser is always last.
AI_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/keys). The fallback model is tried if the primary
# is rate-limited, down, or returns output that doesn't cite the report.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODEL=openrouter/free

# Optional: Google Gemini as an extra fallback (or primary with AI_PROVIDER=gemini).
# GEMINI_MODEL defaults to gemini-2.5-flash when left empty.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional: public URL of this site, sent to OpenRouter for attribution.
SITE_URL=

# --- Data -------------------------------------------------------------------
DATABASE_URL=file:./dev.db

# --- Review desk ------------------------------------------------------------
# Passcode for /admin. Defaults to "ncpor2026" when empty. SET THIS for any shared deployment.
ADMIN_PASSCODE=
