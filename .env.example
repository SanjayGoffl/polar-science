# Copy to .env (optional — every value below has a working default).

# SQLite database file (relative to project root)
DATABASE_URL="file:./dev.db"

# AI provider: "claude" (needs ANTHROPIC_API_KEY) or "mock" (offline, deterministic).
# With AI_PROVIDER=claude and no key set, the app falls back to mock automatically.
AI_PROVIDER="claude"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# Passcode for the /admin review screen
ADMIN_PASSCODE="ncpor2026"
