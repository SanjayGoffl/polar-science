// Polar Stories — data model
//
// Source content (stations, expeditions, documents, media, resources) is imported from
// official snapshots in data/sources and is identified by stable natural keys, so a re-sync
// updates rows in place instead of duplicating them. User content (field entries) and
// AI output are never touched by a sync.
//
// Provenance rules enforced in SQL (see migrations): every AIContent row points at exactly
// one source; official documents must carry their source URL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Station {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  region       String // antarctica | arctic | himalaya
  kind         String // station | historic
  lat          Float
  lng          Float
  established  String? // as stated by the source, e.g. "1 July 2008"
  elevation    String?
  location     String
  description  String
  sourceUrl    String // official page backing the facts above
  liveKey      String? // key on data.ncpor.res.in for live weather
  expeditions  Expedition[]
  media        Media[]
  resources    Resource[]
  fieldEntries FieldEntry[]
}

/// An expedition, a long-running programme, or a milestone (e.g. a station opening).
model Expedition {
  id        String         @id @default(cuid())
  slug      String         @unique
  kind      String         @default("expedition") // expedition | programme | milestone
  name      String
  shortName String
  number    Int?
  year      Int
  season    String?
  region    String
  stationId String? // null for milestones that predate any station
  station   Station?       @relation(fields: [stationId], references: [id])
  summary   String
  sourceUrl String
  featured  Boolean        @default(false)
  hasStory  Boolean        @default(false)
  chapters  StoryChapter[]
  reports   Report[]
  media     Media[]
  resources Resource[]
}

/// One step of an Expedition Story. Text is quoted from a source document section.
model StoryChapter {
  id              String     @id @default(cuid())
  expeditionId    String
  expedition      Expedition @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  order           Int
  kind            String // why | what | where | who | found | data | publications | media
  title           String
  body            String
  sourceReportId  String?
  sourceReport    Report?    @relation(fields: [sourceReportId], references: [id], onDelete: SetNull)
  sourceSection   String? // section number within the source document
  lat             Float?
  lng             Float?
  zoom            Int?
  mediaId         String?
}

/// An official source document (press release, report, publication), stored section by section.
model Report {
  id            String          @id @default(cuid())
  slug          String          @unique
  expeditionId  String
  expedition    Expedition      @relation(fields: [expeditionId], references: [id], onDelete: Cascade)
  title         String
  type          String // press-release | expedition-report | publication | parliament-answer
  publisher     String
  authors       String?
  publishedOn   DateTime
  abstract      String
  externalUrl   String
  contentStatus String          @default("official") // official | community
  sourceSystem  String // pib | ncpor | npdc | dspace
  sourceId      String
  contentHash   String
  retrievedAt   DateTime
  updatedAt     DateTime        @default(now()) @updatedAt
  sections      ReportSection[]
  aiContent     AIContent[]
  chapters      StoryChapter[]

  @@unique([sourceSystem, sourceId])
}

model ReportSection {
  id       String            @id @default(cuid())
  reportId String
  report   Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  order    Int
  number   String
  heading  String
  body     String
  citedBy  AIContentSource[]

  @@unique([reportId, number])
}

/// Licensed photo or official video, with attribution.
model Media {
  id           String      @id @default(cuid())
  kind         String // photo | video
  title        String
  caption      String
  altText      String
  url          String // local image path, or YouTube watch URL
  youtubeId    String?
  author       String
  license      String
  licenseUrl   String?
  sourceUrl    String      @unique // file page / video page: the dedupe key
  stationId    String?
  station      Station?    @relation(fields: [stationId], references: [id], onDelete: SetNull)
  expeditionId String?
  expedition   Expedition? @relation(fields: [expeditionId], references: [id], onDelete: SetNull)
}

/// Official data portal, dataset, live-data page or repository.
model Resource {
  id           String      @id @default(cuid())
  title        String
  url          String      @unique
  kind         String // live-data | dataset | portal | repository | station-page
  description  String
  publisher    String
  stationId    String?
  station      Station?    @relation(fields: [stationId], references: [id], onDelete: SetNull)
  expeditionId String?
  expedition   Expedition? @relation(fields: [expeditionId], references: [id], onDelete: SetNull)
}

model FieldEntry {
  id           String      @id // client-generated UUID -> idempotent sync
  stationId    String
  station      Station     @relation(fields: [stationId], references: [id])
  activity     String
  notes        String
  photoUrl     String?
  submittedBy  String
  capturedAt   DateTime
  syncedAt     DateTime    @default(now())
  reviewStatus String      @default("pending") // pending | approved | rejected
  reviewedAt   DateTime?
  aiContent    AIContent[]

  @@index([stationId, reviewStatus])
}

model AIContent {
  id                 String            @id @default(cuid())
  kind               String // explanation | caption
  audience           String // student | public | social
  text               String
  provider           String // openrouter | gemini | offline
  model              String
  generatedAt        DateTime          @default(now())
  reviewStatus       String            @default("pending")
  reviewedAt         DateTime?
  editedByReviewer   Boolean           @default(false)
  sourceHash         String // hash of the cited document when generated; a mismatch means stale
  promptVersion      String
  sourceReportId     String?
  sourceReport       Report?           @relation(fields: [sourceReportId], references: [id], onDelete: Cascade)
  sourceFieldEntryId String?
  sourceFieldEntry   FieldEntry?       @relation(fields: [sourceFieldEntryId], references: [id], onDelete: Cascade)
  sources            AIContentSource[]

  @@index([sourceReportId, kind, audience, sourceHash])
}

/// Section-level provenance: which exact document sections an output is grounded in.
model AIContentSource {
  aiContentId String
  sectionId   String
  aiContent   AIContent     @relation(fields: [aiContentId], references: [id], onDelete: Cascade)
  section     ReportSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([aiContentId, sectionId])
}

/// Region labels and descriptions shown across the site.
model Region {
  slug  String @id // antarctica | arctic | himalaya
  label String
  blurb String
  order Int
}

/// Editable site copy (headings, introductions, tour steps), keyed by location.
model SiteCopy {
  key   String @id
  value String
}
